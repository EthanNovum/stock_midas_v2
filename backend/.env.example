# 数据库
MIDAS_DB_PATH=backend/data/midas.sqlite3

# Redis（可选）：配置且可连通时，数据同步任务状态走 Redis 实时模式
# REDIS_URL=redis://127.0.0.1:6379/0

# AkShare 同步基础限制：每次任务最多处理股票数
MIDAS_AKSHARE_LIMIT=300

# AkShare 并发抓取配置
# 单任务内抓取并发数（建议从 4 开始逐步上调）
MIDAS_AKSHARE_FETCH_CONCURRENCY=4

# 抓取/入库流水线队列大小（生产者-消费者缓冲区）
MIDAS_AKSHARE_PIPELINE_QUEUE_SIZE=8

# 重试策略：最大重试次数、基础退避毫秒、最大退避毫秒
MIDAS_AKSHARE_RETRY_MAX_ATTEMPTS=3
MIDAS_AKSHARE_RETRY_BASE_DELAY_MS=300
MIDAS_AKSHARE_RETRY_MAX_DELAY_MS=5000

# 默认限流（每秒请求数）
MIDAS_AKSHARE_RATE_LIMIT_RPS=5

# 按数据源覆盖限流（可选）
# 格式：bucket=rps,bucket=rps
# 可用 bucket 示例：
# history_tx, history_sina, history_em, spot, code_name,
# industry, profile, xueqiu, fundamental, value, dividend, revenue, holder
# MIDAS_AKSHARE_RATE_LIMIT_RPS_OVERRIDES=history_tx=2,history_sina=1.5,history_em=3